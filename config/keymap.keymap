#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "layers.h"

// knttnk/keyballのmykeymapを、torabo-tsuki LPのLサイズに移したキーマップ。
// レイヤーは、layers.hに書いた番号の順に並べる。

// JIS配列のPCで入力される文字に合わせたキー名。
// ZMKのキー名はUS配列の刻印を表すので、JIS配列の刻印に対応する名前をここで付ける。
#define JP_MINS MINUS         /* - */
#define JP_CIRC EQUAL         /* ^ */
#define JP_YEN INT_YEN        /* ¥ */
#define JP_AT LBKT            /* @ */
#define JP_LBRC RBKT          /* [ */
#define JP_SCLN SEMI          /* ; */
#define JP_COLN SQT           /* : */
#define JP_RBRC NUHS          /* ] */
#define JP_COMM COMMA         /* , */
#define JP_DOT DOT            /* . */
#define JP_SLSH FSLH          /* / */
#define JP_BSLS INT_RO        /* バックスラッシュ。「ろ」のキー。 */
#define JP_MHEN INT_MUHENKAN  /* 無変換 */
#define JP_HENK INT_HENKAN    /* 変換 */
#define JP_CAPS LS(CAPS)      /* CapsLock。JIS配列ではShiftと同時に押す。 */

/ {
    behaviors {
        // 押している間だけレイヤーを有効にする。押したときにマウスのレイヤーの固定も解除する。
        // 実装はsrc/behavior_mo_unlock.cにある。
        mo_unlock: mo_unlock {
            compatible = "zmk,behavior-momentary-layer-unlock";
            #binding-cells = <1>;
            display-name = "Momentary Layer Unlock";
            unlock-layers = <L_MOUSE>;
        };

        // キーを送る。ただし、スクロール中にボールを閾値以上動かしていたら何も送らない。
        // 実装はsrc/behavior_kp_unless_moved.cにある。
        kp_unless_moved: kp_unless_moved {
            compatible = "zmk,behavior-kp-unless-moved";
            #binding-cells = <1>;
            display-name = "Key Press Unless Moved";
            // センサーの移動量の合計で指定する。608CPIなので、8はボールの表面で約0.3mmにあたる。
            // 手が触れて少し動いただけなら無変換を送り、スクロールしたら送らないための値。
            motion-threshold = <8>;
        };

        // 親指用。タップで無変換か変換を送り、ホールドでレイヤーを有効にする。
        //   タップ: 他のキーを押さず、ボールも回さずに離したとき。押していた長さは問わない。
        //           離す前に次のキーを押し始めても、先に親指を離せばタップになる。
        //   ホールド: 親指を押している間に、他のキーを押して離したとき。
        //             150ms以上押してから他のキーを押したときも、ホールドになる。
        // 押した直後からレイヤーを有効にするので、判定を待たずにボールがスクロールになる。
        // 押してから150ms以内に押した他のキーは、判定が決まるまで出力を待たせる。
        lt_ime: lt_ime {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            hold-while-undecided;
            retro-tap;
            bindings = <&mo_unlock>, <&kp_unless_moved>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 文字入力。3行目の内側は、左がBluetoothのレイヤー、右がマウスのレイヤーの固定と解除。
        layer_base {
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3    &kp N4                 &kp N5                                    &kp N6                   &kp N7  &kp N8     &kp N9   &kp N0     &kp BSPC
&kp TAB    &kp Q   &kp W     &kp E     &kp R                  &kp T                                     &kp Y                    &kp U   &kp I      &kp O    &kp P      &kp JP_MINS
&kp LSHFT  &kp A   &kp S     &kp D     &kp F                  &kp G      &mo L_BT   &tog L_MOUSE        &kp H                    &kp J   &kp K      &kp L    &kp SEMI   &kp ENTER
&kp LCTRL  &kp Z   &kp X     &kp C     &kp V                  &kp B      &mkp MCLK  &mo_unlock L_FN     &kp N                    &kp M   &kp COMMA  &kp DOT  &kp FSLH   &kp RSHFT
&none      &none   &kp LWIN  &kp LALT  &lt_ime L_NAV JP_MHEN  &mkp LCLK  &mkp RCLK  &kp SPACE           &lt_ime L_MOUSE JP_HENK  &none   &none      &none    &kp RCTRL  &none
            >;
        };

        // ナビゲーションと記号。有効な間はボールがスクロールになる。
        layer_nav {
            bindings = <
&none   &none     &none      &none    &none   &none                   &none   &none        &kp JP_MINS  &kp JP_CIRC  &kp JP_YEN   &kp DEL
&trans  &none     &kp PG_UP  &none    &none   &none                   &none   &none        &none        &kp JP_AT    &kp JP_LBRC  &none
&trans  &kp HOME  &kp PG_DN  &kp END  &none   &none   &trans  &trans  &none   &none        &kp JP_SCLN  &kp JP_COLN  &kp JP_RBRC  &trans
&trans  &none     &kp INS    &none    &none   &none   &trans  &trans  &none   &kp JP_COMM  &kp JP_DOT   &kp JP_SLSH  &kp JP_BSLS  &trans
&none   &none     &trans     &trans   &trans  &none   &none   &none   &trans  &none        &none        &none        &trans       &none
            >;
        };

        // ファンクションキー、画面の明るさ、音量
        layer_fn {
            bindings = <
&none   &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                       &kp F6  &kp F7        &kp F8        &kp F9  &kp F10  &kp DEL
&trans  &kp F11  &kp F12  &none   &none   &none                        &none   &kp C_BRI_UP  &kp C_VOL_UP  &none   &none    &trans
&trans  &none    &none    &none   &none   &none     &trans    &trans   &none   &kp C_BRI_DN  &kp C_VOL_DN  &none   &none    &trans
&trans  &none    &none    &none   &none   &none     &trans    &trans   &none   &none         &kp C_MUTE    &none   &none    &trans
&none   &none    &trans   &trans  &trans  &mkp MB4  &mkp MB5  &none    &trans  &none         &none         &none   &trans   &none
            >;
        };

        // 矢印キーとマウスボタン。Kを押している間はボールがスクロールになる。
        // 3行目内側の右のキーで固定と解除を切り替える。
        // 無変換の親指キーか、ファンクションのレイヤーのキーを押しても解除される。
        layer_mouse {
            bindings = <
&none   &none     &none     &none      &none   &none                        &none     &none      &none         &none      &none   &kp DEL
&trans  &none     &kp UP    &none      &none   &kp KP_NUM                   &none     &none      &mkp MCLK     &none      &none   &trans
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &none   &kp SLCK     &trans  &trans  &mkp MB4  &mkp LCLK  &mo L_SCROLL  &mkp RCLK  &none   &trans
&trans  &none     &none     &none      &none   &kp JP_CAPS  &trans  &trans  &mkp MB5  &none      &none         &none      &none   &trans
&none   &none     &trans    &trans     &trans  &none        &none   &none   &trans    &none      &none         &none      &trans  &none
            >;
        };

        // Bluetoothの操作。3行目内側の左のキーを押している間だけ有効になる。他のキーは効かない。
        //   0から4: 接続先のプロファイルを選ぶ。
        //   右上: 選んでいるプロファイルのペアリング情報を消す。
        //   U: USBで接続したPCへ出力する。 B: Bluetoothの接続先へ出力する。
        layer_bt {
            bindings = <
&none  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                        &none  &none         &none  &none  &bt BT_SEL 0  &bt BT_CLR
&none  &none         &none         &none         &none         &none                        &none  &out OUT_USB  &none  &none  &none         &none
&none  &none         &none         &none         &none         &none         &trans  &none  &none  &none         &none  &none  &none         &none
&none  &none         &none         &none         &none         &out OUT_BLE  &none   &none  &none  &none         &none  &none  &none         &none
&none  &none         &none         &none         &none         &none         &none   &none  &none  &none         &none  &none  &none         &none
            >;
        };

        // スクロール専用。キーは下のレイヤーのまま、ボールだけがスクロールになる。
        layer_scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
